generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  LIBRARIAN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CopyCondition {
  GOOD
  DAMAGED
  LOST
}

enum CopyStatus {
  AVAILABLE
  ISSUED
  RESERVED
  MAINTENANCE
}

enum BorrowRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum FineType {
  OVERDUE
  DAMAGED
  LOST
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  BORROW_REQUEST
  APPROVED
  REJECTED
  ISSUED
  DUE_REMINDER
  OVERDUE
  RESERVATION_READY
  FINE_GENERATED
  FINE_PAID
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          Role     @default(MEMBER)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  member              Member?
  booksCreated        Book[]             @relation("BookCreatedBy")
  requestsResponded   BorrowRequest[]    @relation("RespondedBy")
  loansIssued         Loan[]             @relation("IssuedBy")
  loansReturned       Loan[]             @relation("ReturnedBy")
  finePaymentsRecorded FinePayment[]     @relation("RecordedBy")
  notifications       Notification[]
  activityLogs        ActivityLog[]
  settingsUpdated     LibrarySetting[]

  @@map("users")
}

// ─────────────────────────────────────────
// MEMBERS
// ─────────────────────────────────────────

model Member {
  id              Int          @id @default(autoincrement())
  userId          Int          @unique @map("user_id")
  memberCode      String       @unique @map("member_code")
  phone           String?
  address         String?
  maxBooksAllowed Int          @default(3) @map("max_books_allowed")
  joinedDate      DateTime     @default(now()) @map("joined_date")
  status          MemberStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  user           User            @relation(fields: [userId], references: [id])
  borrowRequests BorrowRequest[]
  loans          Loan[]
  fines          Fine[]
  reservations   Reservation[]

  @@map("members")
}

// ─────────────────────────────────────────
// BOOKS & CATEGORIES
// ─────────────────────────────────────────

model BookCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  books Book[]

  @@map("book_categories")
}

model Book {
  id              Int      @id @default(autoincrement())
  title           String
  isbn            String   @unique
  author          String
  publisher       String?
  categoryId      Int      @map("category_id")
  publicationYear Int?     @map("publication_year")
  description     String?
  coverImageUrl   String?  @map("cover_image_url")
  totalCopies     Int      @default(0) @map("total_copies")
  availableCopies Int      @default(0) @map("available_copies")
  shelfLocation   String?  @map("shelf_location")
  createdById     Int      @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  category       BookCategory    @relation(fields: [categoryId], references: [id])
  createdBy      User            @relation("BookCreatedBy", fields: [createdById], references: [id])
  copies         BookCopy[]
  borrowRequests BorrowRequest[]
  reservations   Reservation[]

  @@map("books")
}

model BookCopy {
  id        Int           @id @default(autoincrement())
  bookId    Int           @map("book_id")
  copyCode  String        @unique @map("copy_code")
  condition CopyCondition @default(GOOD)
  status    CopyStatus    @default(AVAILABLE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  // Relations
  book  Book   @relation(fields: [bookId], references: [id])
  loans Loan[]

  @@map("book_copies")
}

// ─────────────────────────────────────────
// BORROW REQUESTS
// ─────────────────────────────────────────

model BorrowRequest {
  id               Int                 @id @default(autoincrement())
  memberId         Int                 @map("member_id")
  bookId           Int                 @map("book_id")
  status           BorrowRequestStatus @default(PENDING)
  requestDate      DateTime            @default(now()) @map("request_date")
  responseDate     DateTime?           @map("response_date")
  respondedById    Int?                @map("responded_by")
  rejectionReason  String?             @map("rejection_reason")
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  // Relations
  member      Member  @relation(fields: [memberId], references: [id])
  book        Book    @relation(fields: [bookId], references: [id])
  respondedBy User?   @relation("RespondedBy", fields: [respondedById], references: [id])
  loan        Loan?

  @@map("borrow_requests")
}

// ─────────────────────────────────────────
// LOANS
// ─────────────────────────────────────────

model Loan {
  id                   Int        @id @default(autoincrement())
  borrowRequestId      Int?       @unique @map("borrow_request_id")
  memberId             Int        @map("member_id")
  bookCopyId           Int        @map("book_copy_id")
  issuedById           Int        @map("issued_by")
  issueDate            DateTime   @default(now()) @map("issue_date")
  dueDate              DateTime   @map("due_date")
  returnDate           DateTime?  @map("return_date")
  status               LoanStatus @default(ACTIVE)
  returnCondition      CopyCondition? @map("return_condition")
  returnedRecordedById Int?       @map("returned_recorded_by")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  // Relations
  borrowRequest      BorrowRequest? @relation(fields: [borrowRequestId], references: [id])
  member             Member         @relation(fields: [memberId], references: [id])
  bookCopy           BookCopy       @relation(fields: [bookCopyId], references: [id])
  issuedBy           User           @relation("IssuedBy", fields: [issuedById], references: [id])
  returnedRecordedBy User?          @relation("ReturnedBy", fields: [returnedRecordedById], references: [id])
  fines              Fine[]

  @@map("loans")
}

// ─────────────────────────────────────────
// FINES
// ─────────────────────────────────────────

model Fine {
  id          Int      @id @default(autoincrement())
  loanId      Int      @map("loan_id")
  memberId    Int      @map("member_id")
  fineType    FineType @map("fine_type")
  amount      Float
  daysOverdue Int      @default(0) @map("days_overdue")
  isPaid      Boolean  @default(false) @map("is_paid")
  generatedAt DateTime @default(now()) @map("generated_at")
  paidAt      DateTime? @map("paid_at")

  // Relations
  loan     Loan         @relation(fields: [loanId], references: [id])
  member   Member       @relation(fields: [memberId], references: [id])
  payments FinePayment[]

  @@map("fines")
}

model FinePayment {
  id            Int      @id @default(autoincrement())
  fineId        Int      @map("fine_id")
  amountPaid    Float    @map("amount_paid")
  paymentMethod String?  @map("payment_method")
  recordedById  Int      @map("recorded_by")
  paymentDate   DateTime @default(now()) @map("payment_date")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  fine       Fine @relation(fields: [fineId], references: [id])
  recordedBy User @relation("RecordedBy", fields: [recordedById], references: [id])

  @@map("fine_payments")
}

// ─────────────────────────────────────────
// RESERVATIONS
// ─────────────────────────────────────────

model Reservation {
  id            Int               @id @default(autoincrement())
  memberId      Int               @map("member_id")
  bookId        Int               @map("book_id")
  queuePosition Int               @map("queue_position")
  status        ReservationStatus @default(ACTIVE)
  reservedAt    DateTime          @default(now()) @map("reserved_at")
  expiresAt     DateTime?         @map("expires_at")
  notifiedAt    DateTime?         @map("notified_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  // Relations
  member Member @relation(fields: [memberId], references: [id])
  book   Book   @relation(fields: [bookId], references: [id])

  @@unique([memberId, bookId, status])
  @@map("reservations")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─────────────────────────────────────────
// LIBRARY SETTINGS
// ─────────────────────────────────────────

model LibrarySetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedById Int?     @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("library_settings")
}

// ─────────────────────────────────────────
// ACTIVITY LOGS
// ─────────────────────────────────────────

model ActivityLog {
  id         Int      @id @default(autoincrement())
  actorId    Int      @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@map("activity_logs")
}
